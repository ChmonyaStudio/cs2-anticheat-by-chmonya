<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CSAntiCheat</AssemblyName>
    <RootNamespace>CSAntiCheat</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Metadata -->
    <Product>AntiCheat</Product>
    <Version>2.4.1</Version>
    <Authors>Chmonya</Authors>
    <Description>Anti-cheat plugin for CS2 CounterStrikeSharp servers</Description>
    <Copyright>Copyright (c) 2026 Chmonya</Copyright>

    <!-- Build settings -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.302" />
  </ItemGroup>

</Project>
